{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oaklandnoir",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "oaklandnoir.sanctumos.net",
      "custom_domain": true,
      "previews_enabled": false
    }
  ]
}
